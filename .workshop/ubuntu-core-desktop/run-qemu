#!/bin/bash

# Boot build/pc.img via the repo's run-qemu.sh from inside the
# Workshop container. The container has no host bridge and no
# /dev/net/tun, so user-mode networking is required there; everything
# else (flock, seed handling, VNC, serial unix socket, audio gating)
# comes from run-qemu.sh itself.

set -euo pipefail

# The custom-device interface preserves the host device's numeric
# group, which may resolve to an unrelated group inside the container.
# qemu needs read/write on /dev/kvm; fix the ACL when the device is
# present but not writable. Tolerate failure: passwordless sudo is
# provided by the workshop image, but if it is not, tell the user how
# to work around it rather than failing here.
if [[ -c /dev/kvm && ( ! -r /dev/kvm || ! -w /dev/kvm ) ]]; then
  if ! sudo -n setfacl -m "u:$(id -u):rw" /dev/kvm 2>/dev/null; then
    echo "Warning: cannot adjust the ACL on /dev/kvm; if QEMU fails to" >&2
    echo "open it, rerun this action as root: workshop run --uid 0 ..." >&2
  fi
fi

exec ./run-qemu.sh --net user --serial-socket build/serial.sock "$@"
