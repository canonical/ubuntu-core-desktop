#!/bin/bash

missing=()
for command in fakeroot gh mksquashfs qemu-system-x86_64 unsquashfs ubuntu-image; do
  command -v "${command}" >/dev/null 2>&1 || missing+=("${command}")
done

for path in \
  /project/build.sh \
  /project/build-snaps.sh \
  /project/ci/account-key.assert \
  /project/ci/ubuntu-core-desktop-26-amd64-dangerous.model \
  /project/ci/ubuntu-core-desktop-kde-26-amd64-dangerous.model
do
  [[ -e ${path} ]] || missing+=("${path}")
done

[[ -e /usr/share/ovmf/OVMF.fd ]] || missing+=("/usr/share/ovmf/OVMF.fd")

if ! qemu-system-x86_64 -display help 2>&1 | grep -qx sdl; then
  missing+=("QEMU SDL display backend")
fi

if (( ${#missing[@]} > 0 )); then
  workshopctl set-health error "missing required build files or tools: ${missing[*]}"
  exit 0
fi

# Manual grants: report but do not fail the health check when these are
# missing - the build works without them, only the graphical QEMU run
# is affected (slowly, or not at all).
warnings=()
[[ -c /dev/kvm ]] || warnings+=("/dev/kvm (workshop connect ...:kvm :custom-device)")
compgen -G '/dev/dri/renderD*' >/dev/null || warnings+=("/dev/dri (gpu interface plug)")
if (( ${#warnings[@]} > 0 )); then
  echo "Missing optional devices: ${warnings[*]}" >&2
  echo "Image builds work without them; graphical QEMU runs need both." >&2
fi

workshopctl set-health okay
