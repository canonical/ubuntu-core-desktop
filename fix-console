#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="${1:-squashfs-root}"
# The serial console port: ttyS0 on amd64, ttyAMA0 on arm64 (the
# QEMU virt machine and typical arm boards have no ttyS0). build.sh
# passes the port matching its --arch.
PORT="${2:-ttyS0}"
SYSTEMD="$ROOT/etc/systemd/system"

if [[ ! -d "$ROOT/etc" ]]; then
    echo "ERROR: not an extracted root filesystem: $ROOT" >&2
    exit 1
fi

echo "Modifying extracted root filesystem: $ROOT"

# The two heredocs below are deliberately quoted (<<'EOF') so the
# profile.d snippet's $(tty ...) and stty reach the image verbatim;
# the port goes in through this placeholder + sed instead.
tee $ROOT/etc/profile.d/serial-terminal.sh >/dev/null <<'EOF'
# Terminal dimensions for the QEMU serial console.
if [ "$(tty 2>/dev/null)" = "/dev/__PORT__" ]; then
    stty rows 55 cols 86 2>/dev/null || :
fi
EOF
sed -i "s/__PORT__/${PORT}/g" $ROOT/etc/profile.d/serial-terminal.sh

chown root:root $ROOT/etc/profile.d/serial-terminal.sh
chmod 0644 $ROOT/etc/profile.d/serial-terminal.sh

mkdir -p \
    "$SYSTEMD" \
    "$SYSTEMD/basic.target.wants"

# Remove previous enablement links.
rm -f \
    "$SYSTEMD/getty.target.wants/serial-getty@${PORT}.service" \
    "$SYSTEMD/sysinit.target.wants/serial-getty@${PORT}.service" \
    "$SYSTEMD/sysinit.target.wants/early-serial-getty.service" \
    "$SYSTEMD/basic.target.wants/serial-getty@${PORT}.service" \
    "$SYSTEMD/basic.target.wants/early-serial-getty.service"

# Remove previous drop-ins.
rm -rf \
    "$SYSTEMD/serial-getty@${PORT}.service.d" \
    "$SYSTEMD/early-serial-getty.service.d"

# Prevent Ubuntu Core's serial-console setup from taking over ${PORT}.
ln -sfn /dev/null \
    "$SYSTEMD/serial-console-conf@${PORT}.service"

# Prevent the standard serial getty from competing with our getty.
ln -sfn /dev/null \
    "$SYSTEMD/serial-getty@${PORT}.service"

# Install the early serial getty.
tee "$SYSTEMD/early-serial-getty.service" >/dev/null <<'EOF'
[Unit]
Description=Early Serial Getty on __PORT__
Requires=dev-__PORT__.device
After=dev-__PORT__.device

[Service]
Type=simple
ExecStart=/sbin/agetty --keep-baud 115200,57600,38400,9600 __PORT__ vt100
Environment=TERM=xterm-256color
Restart=always
RestartSec=1
TTYPath=/dev/__PORT__
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=no

[Install]
WantedBy=basic.target
EOF
sed -i "s/__PORT__/${PORT}/g" "$SYSTEMD/early-serial-getty.service"

chown root:root \
    "$SYSTEMD/early-serial-getty.service"

chmod 0644 \
    "$SYSTEMD/early-serial-getty.service"

ln -sfn ../early-serial-getty.service \
    "$SYSTEMD/basic.target.wants/early-serial-getty.service"

echo
echo "Installed unit:"
sed -n '1,200p' \
    "$SYSTEMD/early-serial-getty.service"

echo
echo "Relevant links:"
ls -l \
    "$SYSTEMD/basic.target.wants/early-serial-getty.service" \
    "$SYSTEMD/serial-getty@${PORT}.service" \
    "$SYSTEMD/serial-console-conf@${PORT}.service"

echo
echo "Done."
